{
  "name": "financial-flag-icons",
  "license": "MIT",
  "version": "1.1.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Divine Zvenyika",
  "module": "dist/index.esm.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons/*": {
      "import": "./dist/modules/icons/*.js",
      "require": "./dist/modules/icons/*.js",
      "types": "./dist/types/icons/*.d.ts"
    }
  },
  "description": "A package to show flag icons for currency pairs",
  "files": [
    "dist",
    "dist/modules",
    "!dist/*.map"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --noEmit false && tsc -p tsconfig.modules.json && node scripts/minify-modules.mjs && rspack build -c rspack.config.js && rollup -c",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedivinez/financial-flag-icons.git"
  },
  "keywords": [
    "React",
    "Financial",
    "Currency",
    "Pair",
    "Icons",
    "Flags"
  ],
  "bugs": {
    "url": "https://github.com/thedivinez/financial-flag-icons/issues"
  },
  "homepage": "https://github.com/thedivinez/financial-flag-icons#readme",
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/preset-react": "^7.18.6",
    "@chromatic-com/storybook": "^3.2.4",
    "@rollup/plugin-commonjs": "^23.0.0",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@rspack/cli": "^1.7.11",
    "@rspack/core": "^1.7.11",
    "@storybook/addon-actions": "^8.5.1",
    "@storybook/addon-essentials": "^8.5.1",
    "@storybook/addon-interactions": "^8.5.1",
    "@storybook/addon-links": "^8.5.1",
    "@storybook/addon-mdx-gfm": "^8.5.1",
    "@storybook/addon-webpack5-compiler-swc": "^2.0.0",
    "@storybook/react": "^8.5.1",
    "@storybook/react-webpack5": "^8.5.1",
    "@storybook/test": "^8.5.1",
    "@types/node": "^18.8.3",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "babel-loader": "^8.2.5",
    "esbuild": "^0.25.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.17",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^2.79.1",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-dts": "^4.2.3",
    "storybook": "^8.5.1",
    "typescript": "^4.8.4"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}